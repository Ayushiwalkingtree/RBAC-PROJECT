# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── Table prefix (change to customise, e.g. "ns_") ────────────────────────────
NT_TABLE_PREFIX=nt_

# ── JWT  (use RS256 + Kong in production) ─────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-minimum-32-chars
JWT_ALGORITHM=HS256

# ── Encryption key for SMTP credentials (must be exactly 32 bytes) ────────────
ENCRYPTION_KEY=change-me-to-32-byte-secret-key!!

# ── Service-to-service token ──────────────────────────────────────────────────
SERVICE_API_KEY=change-me-internal-service-key

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ── Email queue tuning ────────────────────────────────────────────────────────
EMAIL_MAX_RETRY=3
EMAIL_RETRY_BACKOFF_BASE_S=60
EMAIL_WORKER_COUNT=5

# ── Attachment limits ─────────────────────────────────────────────────────────
ATTACHMENT_MAX_FILE_MB=25
ATTACHMENT_MAX_TOTAL_MB=50
MAX_RECIPIENTS_PER_SEND=50

# ── Template storage (DB | FILE | S3) ─────────────────────────────────────────
TEMPLATE_STORAGE_DEFAULT=DB
S3_BUCKET=
S3_ENDPOINT_URL=

# ── ClamAV virus scanning ─────────────────────────────────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav

# ── App behaviour ─────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
AUTO_CREATE_TABLES=true
LOG_LEVEL=INFO
